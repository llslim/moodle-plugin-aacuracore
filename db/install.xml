<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/aacuracore/db" VERSION="20240303" COMMENT="XMLDB file for Moodle local/local_aacuracore"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="local_aacuracore_usage" COMMENT="Stores information on how much ChatGPT was used">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="send" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="receive" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="model" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="prompt_tokens" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="completion_tokens" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="datecreated" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_aacuracore_h5p" COMMENT="Stores H5P itens">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="contentbanktid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID do bando de H5P para edição"/>
                <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="type" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="data" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_aacuracore_h5ppages" COMMENT="Stores H5P Pages">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="h5pid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="type" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="data" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_aacuracore_sessions" COMMENT="Maintains active chatbot sessions and current progress">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course module ID of mod_aacurachat instance"/>
                <FIELD NAME="scenariocode" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="current_state" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="START" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="userid_cmid_scenariocode_idx" UNIQUE="false" FIELDS="userid, cmid, scenariocode"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_aacuracore_messages" COMMENT="Stores full text transcripts for evaluation and grade reviews">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="sender" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="user" SEQUENCE="false"/>
                <FIELD NAME="message_text" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timestamp" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="session_fk" TYPE="foreign" FIELDS="sessionid" REFTABLE="local_aacuracore_sessions" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_aacuracore_analytics" COMMENT="Tracks performance evaluation markers and diagnostic scores">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="metric_type" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="metric_value" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0.00" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="session_fk" TYPE="foreign" FIELDS="sessionid" REFTABLE="local_aacuracore_sessions" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_aacuracore_custom_scenarios" COMMENT="Stores custom JSON persona scenarios uploaded site-wide">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="scenariocode" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="json_data" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="scenariocode_unique" TYPE="unique" FIELDS="scenariocode"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_aacuracore_evaluations" COMMENT="Stores final grading feedback and normalized scores for simulation sessions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="score" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0.00" SEQUENCE="false"/>
                <FIELD NAME="feedback" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="session_fk" TYPE="foreign" FIELDS="sessionid" REFTABLE="local_aacuracore_sessions" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_aacuracore_sim_log" COMMENT="Stores full minimum-turn simulation diagnostic logs">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="scenariocode" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="minturns" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="8" SEQUENCE="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="detail" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="created" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_aacuracore_topics" COMMENT="Stores clinical topics for the AACURA Topic and Scenario Library">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="topiccode" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="default_role_type" TYPE="char" LENGTH="50" NOTNULL="false" DEFAULT="parent" SEQUENCE="false"/>
                <FIELD NAME="default_min_turns" TYPE="int" LENGTH="6" NOTNULL="false" DEFAULT="8" SEQUENCE="false"/>
                <FIELD NAME="default_intensity" TYPE="char" LENGTH="20" NOTNULL="false" DEFAULT="medium" SEQUENCE="false"/>
                <FIELD NAME="scope" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="system" SEQUENCE="false"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="visible" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="topiccode_courseid_uq" UNIQUE="true" FIELDS="topiccode, courseid"/>
                <INDEX NAME="scope_courseid_visible_idx" UNIQUE="false" FIELDS="scope, courseid, visible"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_aacuracore_scenarios" COMMENT="Unified library storing built-in and custom scenarios mapped to a single topic">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="scenariocode" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="topicid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="topiccode" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="parent_counseling" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="role_type" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="parent" SEQUENCE="false"/>
                <FIELD NAME="role_label" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="Parent Persona" SEQUENCE="false"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="json_data" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="is_builtin" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="scope" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="system" SEQUENCE="false"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="visible" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="topic_fk" TYPE="foreign" FIELDS="topicid" REFTABLE="local_aacuracore_topics" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="scenariocode_course_cm_uq" UNIQUE="true" FIELDS="scenariocode, courseid, cmid"/>
                <INDEX NAME="topiccode_visible_idx" UNIQUE="false" FIELDS="topiccode, visible"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
